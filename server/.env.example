# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/college-notes?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars_long
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cookie
COOKIE_DOMAIN=localhost
